{
  "name": "larch-next",
  "version": "0.1.0",
  "private": true,
  "description": "Larch (Demo-Wealthsimple) on Next.js, with a Payload admin panel at /admin.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--no-deprecation payload generate:types"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "cross-env": "10.1.0",
    "graphql": "16.15.0",
    "next": "16.4.5",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.23.4 <23",
    "pnpm": ">=10.16"
  },
  "packageManager": "pnpm@10.28.0"
}
