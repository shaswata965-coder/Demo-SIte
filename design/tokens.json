{
  "$meta": {
    "project": "AXON demo site",
    "theme": "single dark world (deliberate — see design/tokens.css)",
    "rationale": "Accent pair derives from neural weight visualisation: excitatory weights read warm, inhibitory read cool. Every graph edge is coloured by the sign of its weight, so the palette encodes data rather than decorating it."
  },
  "color": {
    "ink":        { "value": "#06070A", "use": "page ground" },
    "inkRaised":  { "value": "#0E1017", "use": "cards, panels" },
    "inkEdge":    { "value": "#171A24", "use": "hairline fills, inputs" },
    "bone":       { "value": "#EAE6DC", "use": "primary text, bright nodes" },
    "boneDim":    { "value": "#B4B2AC", "use": "secondary text" },
    "grey":       { "value": "#7C8091", "use": "labels, captions" },
    "greyDeep":   { "value": "#4A4E5C", "use": "disabled, tick marks" },
    "amber":      { "value": "#FFAE1A", "use": "excitatory signal, primary accent, CTA" },
    "amberDeep":  { "value": "#C97F00", "use": "amber on light fills, pressed state" },
    "indigo":     { "value": "#4C5BD4", "use": "inhibitory signal, structure, risk" },
    "indigoDim":  { "value": "#333C8C", "use": "indigo at low emphasis" },
    "ok":         { "value": "#46C08A", "use": "semantic: healthy" },
    "warn":       { "value": "#E0A33C", "use": "semantic: attention" },
    "crit":       { "value": "#E0574B", "use": "semantic: blocked/failed" }
  },
  "type": {
    "display": { "family": "Archivo", "axes": "wght 400-900, wdth 62-125", "use": "headlines set expanded and heavy — monument, not poster" },
    "body":    { "family": "IBM Plex Sans", "use": "running copy, UI" },
    "mono":    { "family": "IBM Plex Mono", "use": "labels, figures, spec tables, chapter markers" },
    "scale":   { "ratio": 1.26, "steps": ["0.6875rem", "0.8125rem", "0.9375rem", "1.125rem", "1.375rem", "1.875rem", "clamp(1.9rem,3.6vw,3.1rem)", "clamp(2.6rem,8vw,6.4rem)"] }
  },
  "motion": {
    "easing": {
      "out":   "cubic-bezier(0.16, 1, 0.3, 1)",
      "inOut": "cubic-bezier(0.76, 0, 0.24, 1)",
      "snap":  "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "duration": { "fast": 180, "base": 420, "slow": 900, "scene": 1600 },
    "scrollSmoothing": { "lerp": 0.085, "wheelMultiplier": 1.0, "note": "Lenis in production; the prototype ships an 80-line equivalent" }
  },
  "layout": { "gutter": "clamp(1.25rem, 4vw, 4rem)", "measure": "66ch", "breakpoints": { "sm": 640, "md": 900, "lg": 1200, "xl": 1600 } }
}
