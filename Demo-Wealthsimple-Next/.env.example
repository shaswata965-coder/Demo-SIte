# Copy to .env and fill in. Never commit .env.

# Signs admin sessions. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYLOAD_SECRET=

# MongoDB connection string, with the database name before the "?".
# Development: a local server (see README, "Run it").
# Production: MongoDB Atlas, e.g.
#   mongodb+srv://larch-app:<password>@<cluster>.mongodb.net/larch?retryWrites=true&w=majority
# (MONGODB_URI, as set by Vercel's Atlas integration, also works.)
DATABASE_URL=mongodb://127.0.0.1:27017/larch

# The first admin, created on first start when the database has no users.
# Required in production: until a user exists, Payload's "create first user"
# screen is open to anyone, so the app refuses to start without these.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. An extra origin the admin may be used from, with no trailing
# slash. Locally it defaults to http://localhost:3000; on Vercel the
# production domain, branch URLs and deployment URLs are allowed already.
NEXT_PUBLIC_SERVER_URL=
