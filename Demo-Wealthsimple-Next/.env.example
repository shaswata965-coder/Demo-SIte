# Copy to .env and fill in. Never commit .env.

# Signs admin sessions. At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYLOAD_SECRET=

# Content database. A local SQLite file for development; in production point
# this at a hosted libSQL database (Turso), e.g. libsql://larch-you.turso.io,
# and set DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./larch.db
DATABASE_AUTH_TOKEN=

# The first admin, created on first start when the database has no users.
# Required in production: until a user exists, Payload's "create first user"
# screen is open to anyone, so the app refuses to start without these.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The public URL of the site (used for the admin's CSRF allow-list and the
# "view site" link). No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
